# Copie este arquivo para ".env.local" e preencha com os valores reais
# do seu projeto no Supabase (Project Settings > API).

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" do Supabase (Project Settings > API). NUNCA prefixar
# com NEXT_PUBLIC_ nem expor ao navegador — ignora todas as políticas de
# RLS. Usada só em src/lib/supabase/admin.ts, para o cálculo de frete no
# checkout público conseguir ler/renovar o token do Melhor Envio mesmo sem
# sessão de admin.
SUPABASE_SERVICE_ROLE_KEY=

# Melhor Envio (sandbox) — autorização OAuth 2.0 e cálculo de frete no
# checkout. CLIENT_ID/CLIENT_SECRET vêm do app cadastrado no painel sandbox
# (https://sandbox.melhorenvio.com.br). REDIRECT_URI precisa ser IDÊNTICA à
# URL cadastrada nesse painel, ex.: https://seu-dominio.com/admin/integracao/melhorenvio/callback
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=

# CEP de origem dos envios (endereço/depósito da Fhezo), exigido pela API
# do Melhor Envio para calcular o frete.
MELHOR_ENVIO_CEP_ORIGEM=

# Asaas (sandbox) — pagamento via Pix/boleto/cartão no checkout.
# Chave de API: painel do Asaas > Integrações > API Key (use a do ambiente
# sandbox: https://sandbox.asaas.com). Enviada no header "access_token".
ASAAS_API_KEY=

# Token de webhook: defina um valor (qualquer string forte) aqui E cadastre
# o MESMO valor no painel do Asaas ao configurar o webhook (Integrações >
# Webhooks > "Token de acesso"). Usado para validar que a requisição em
# src/app/api/webhooks/asaas/route.ts realmente veio do Asaas.
ASAAS_WEBHOOK_TOKEN=

# Bling (ERP) — autorização OAuth 2.0, sincronização de estoque e envio de
# pedidos pagos. CLIENT_ID/CLIENT_SECRET vêm do aplicativo cadastrado em
# developer.bling.com.br > Meus Aplicativos. REDIRECT_URI precisa ser
# IDÊNTICA à URL cadastrada nesse aplicativo, ex.:
# https://seu-dominio.com/admin/integracao/bling/callback
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=

# ID de uma forma de pagamento já cadastrada na sua conta do Bling
# (Cadastros > Formas de pagamento). Obrigatório: o Bling exige uma forma
# de pagamento em todo pedido de venda criado via API — sem isso, o envio
# de pedidos pagos ao Bling falha (fica visível em "Pedidos pagos não
# sincronizados" no /admin, sem afetar o pagamento em si).
BLING_FORMA_PAGAMENTO_ID=
