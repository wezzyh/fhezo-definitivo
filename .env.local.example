# Copie este arquivo para ".env.local" e preencha com os valores reais
# do seu projeto no Supabase (Project Settings > API).

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" do Supabase (Project Settings > API). NUNCA prefixar
# com NEXT_PUBLIC_ nem expor ao navegador — ignora todas as políticas de
# RLS. Usada só em src/lib/supabase/admin.ts, para o cálculo de frete no
# checkout público conseguir ler/renovar o token do Melhor Envio mesmo sem
# sessão de admin.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AMBIENTE DAS INTEGRAÇÕES (APPSEC-028) — obrigatório, sem valor padrão.
# Aceita SOMENTE "sandbox" ou "production". Regra conferida pelo código e
# pelo build (src/lib/config/regras-ambiente.ts):
#   Vercel Production           → as duas em "production"
#   Vercel Preview e máquina local → as duas em "sandbox"
# Qualquer outra combinação impede pagamento/frete (e, na Vercel, o build).
# As chaves e o app OAuth abaixo precisam ser do MESMO ambiente declarado.
# ---------------------------------------------------------------------------
ASAAS_ENV=sandbox
MELHOR_ENVIO_ENV=sandbox

# ---------------------------------------------------------------------------
# MODO CONSTRUÇÃO E KILL SWITCH DO CHECKOUT (src/lib/config/lancamento.ts)
# Aceitam SOMENTE "true" ou "false". Ausente/inválido cai no lado seguro:
# manutenção LIGADA e checkout DESLIGADO. Em Vercel Production, ausente ou
# inválido derruba o build.
#
# MAINTENANCE_MODE=true  → visitante vê só "Site em construção"; quem digita
#                          MAINTENANCE_PASSWORD na página recebe um cookie
#                          assinado (7 dias) e vê o site real. /admin continua
#                          exigindo o login de admin normalmente.
# CHECKOUT_ENABLED=false → o servidor recusa criar pedido/cobrança (Server
#                          Action criarPedido), independente da tela.
#
# MAINTENANCE_PASSWORD: mínimo 12 caracteres.
# MAINTENANCE_SECRET: chave de assinatura do cookie, mínimo 32 caracteres,
#   diferente da senha. Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar qualquer um dos dois derruba todos os acessos liberados.
# NUNCA prefixar com NEXT_PUBLIC_. Na máquina local, para desenvolver sem a
# página de construção, use MAINTENANCE_MODE=false.
# ---------------------------------------------------------------------------


# Melhor Envio — autorização OAuth 2.0 e cálculo de frete no checkout.
# CLIENT_ID/CLIENT_SECRET vêm do app cadastrado no painel do MESMO ambiente
# de MELHOR_ENVIO_ENV (sandbox: https://sandbox.melhorenvio.com.br;
# produção: https://melhorenvio.com.br). REDIRECT_URI precisa ser IDÊNTICA
# à URL cadastrada nesse app, ex.: https://seu-dominio.com/admin/integracao/melhorenvio/callback
# Ao trocar de ambiente, reconecte em /admin/integracao: token de outro
# ambiente nunca é usado.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=

# CEP de origem dos envios (endereço/depósito da Fhezo), exigido pela API
# do Melhor Envio para calcular o frete.
MELHOR_ENVIO_CEP_ORIGEM=

# Asaas — pagamento via Pix/boleto/cartão no checkout. Chave de API do
# MESMO ambiente de ASAAS_ENV (painel do Asaas > Integrações > API Key;
# sandbox: https://sandbox.asaas.com). Chaves no formato atual começam com
# "$aact_hmlg_" (sandbox) ou "$aact_prod_" (produção) — uma chave do
# ambiente oposto ao de ASAAS_ENV é recusada.
ASAAS_API_KEY=

# Token de webhook: defina um valor (qualquer string forte) aqui E cadastre
# o MESMO valor no painel do Asaas ao configurar o webhook (Integrações >
# Webhooks > "Token de acesso"). Usado para validar que a requisição em
# src/app/api/webhooks/asaas/route.ts realmente veio do Asaas. Use um
# token DIFERENTE em sandbox e em produção.
ASAAS_WEBHOOK_TOKEN=

# Bling (ERP) — autorização OAuth 2.0, sincronização de estoque e envio de
# pedidos pagos. CLIENT_ID/CLIENT_SECRET vêm do aplicativo cadastrado em
# developer.bling.com.br > Meus Aplicativos. REDIRECT_URI precisa ser
# IDÊNTICA à URL cadastrada nesse aplicativo, ex.:
# https://seu-dominio.com/admin/integracao/bling/callback
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=

# ID de uma forma de pagamento já cadastrada na sua conta do Bling
# (Cadastros > Formas de pagamento). Obrigatório: o Bling exige uma forma
# de pagamento em todo pedido de venda criado via API — sem isso, o envio
# de pedidos pagos ao Bling falha (fica visível em "Pedidos pagos não
# sincronizados" no /admin, sem afetar o pagamento em si).
BLING_FORMA_PAGAMENTO_ID=
